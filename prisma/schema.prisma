// ============================================
// Zar30 - Prisma Schema (Phase 0 Foundation)
// ============================================
// Double-Entry Ledger Architecture
// PostgreSQL 18.x + Prisma 7 Stable
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Database URL configured in prisma.config.ts (Prisma 7)

// ============================================
// Enums
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  FINANCE
  SUPPORT
  KYC
  RISK
  CONTENT
  OPERATIONS
  ANALYST
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum KycLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_RESUBMISSION
}

enum AssetType {
  TOMAN
  GOLD
  SILVER
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  LOCKED
  FILLED
  CANCELLED
  FAILED
  REVERSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  FEE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum RateLimitScope {
  IP
  USER
  MOBILE
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

enum InstallmentMethod {
  INTERNAL_CREDIT
  CHEQUE
}

enum InstallmentContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum InstallmentPaymentStatus {
  PENDING
  PAID
  OVERDUE
  DEFAULTED
}

enum InvestmentPositionStatus {
  ACTIVE
  MATURED
  EARLY_CLOSED
}

enum InterestRateType {
  FIXED
  VARIABLE
}

// ============================================
// User & Auth
// ============================================

model User {
  id                  String    @id @default(uuid())
  mobile              String    @unique
  passwordHash        String
  // Profile (Phase 3)
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  email               String?   @map("email")
  avatarUrl           String?   @map("avatar_url")
  kycLevel            KycLevel  @default(LEVEL_0)
  status              UserStatus @default(ACTIVE)
  referralCode        String    @unique
  referredById        String?   @map("referred_by")
  creditScore         Int       @default(0)
  // Security state (Phase 2 — Brute Force Protection)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mobileVerifiedAt    DateTime? @map("mobile_verified_at")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  referredBy      User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]             @relation("Referrals")
  wallet          Wallet?
  kycSubmissions  KycSubmission[]
  sessions        Session[]
  orders          Order[]
  transactions    Transaction[]
  payments        Payment[]
  withdrawals     WithdrawalRequest[]
  adminUser       AdminUser?
  tickets         Ticket[]
  ticketMessages  TicketMessage[]
  notifications   Notification[]
  referralsMade   Referral[]         @relation("Referrer")
  referralReceived Referral?         @relation("Referred")
  installmentContracts InstallmentContract[]
  investmentPositions  InvestmentPosition[]
  bankAccounts      BankAccount[]
  addresses         Address[]
  deliveryRequests  GoldDeliveryRequest[]
  sentTransfers     InternalTransfer[]  @relation("TransferSender")
  receivedTransfers InternalTransfer[]  @relation("TransferRecipient")
  priceAlerts       PriceAlert[]
  sipPlans          RecurringBuyPlan[]
  coinHoldings      CoinHolding[]
  feeOverride       UserFeeOverride?
  riskEvents        RiskEvent[]

  @@index([referredById])
  @@index([status])
  @@map("users")
}

model AdminUser {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  role        AdminRole @default(READ_ONLY)
  permissions Json
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user                User                  @relation(fields: [userId], references: [id])
  kycSubmissions      KycSubmission[]
  withdrawals         WithdrawalRequest[]
  tickets             Ticket[]
  installmentContracts InstallmentContract[]
  deliveryRequests    GoldDeliveryRequest[]
  exportRecords       ExportRecord[]

  @@map("admin_users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ip               String?
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(uuid())
  mobile     String
  codeHash   String    @map("code_hash")
  purpose    String
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([mobile, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model KycSubmission {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  level           KycLevel
  status          KycStatus @default(NOT_STARTED)
  nationalCode    String?   @map("national_code")
  birthDate       DateTime? @map("birth_date")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  shenasnamehNo   String?   @map("shenasnameh_no")
  // داده‌های حساس بانکی — AES-256-GCM رمزنگاری‌شده در حال استراحت
  cardNumberEnc   String?   @map("card_number_enc")
  ibanEnc         String?   @map("iban_enc")
  idCardImageUrl  String?   @map("id_card_image_url")
  selfieImageUrl  String?   @map("selfie_image_url")
  videoUrl        String?   @map("video_url")
  // آخرین step تکمیل‌شده برای resume — draft قابل ویرایش تا SUBMITTED
  currentStep     Int       @default(0) @map("current_step")
  submittedAt     DateTime? @map("submitted_at")
  rejectionReason String?   @map("rejection_reason")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id])
  reviewer   AdminUser?    @relation(fields: [reviewedBy], references: [id])
  documents  KycDocument[]

  @@index([userId])
  @@index([status])
  @@map("kyc_submissions")
}

enum KycDocKind {
  ID_CARD_FRONT
  ID_CARD_BACK
  SELFIE
  VIDEO
}

// مدارک KYC — کلید Object Storage خصوصی + checksum؛ فایل‌ها رمزنگاری‌شده
// هرگز URL عمومی ندارند — دانلود فقط از مسیر API احرازشده
model KycDocument {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  kind         KycDocKind
  storageKey   String     @map("storage_key")
  fileName     String     @map("file_name")
  mimeType     String     @map("mime_type")
  sizeBytes    Int        @map("size_bytes")
  sha256       String
  encrypted    Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")

  submission KycSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
  @@map("kyc_documents")
}

// ============================================
// Wallet & Asset Accounts
// ============================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  assetAccounts AssetAccount[]

  @@map("wallets")
}

model AssetAccount {
  id            String    @id @default(uuid())
  walletId      String    @map("wallet_id")
  assetType     AssetType @map("asset_type")
  balance       Decimal   @default(0) @db.Decimal(18, 8)
  lockedBalance Decimal   @default(0) @db.Decimal(18, 8) @map("locked_balance")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  wallet      Wallet         @relation(fields: [walletId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([walletId, assetType])
  @@index([walletId])
  @@map("asset_accounts")
}

// ============================================
// Double-Entry Ledger
// ============================================

model LedgerAccount {
  id        String           @id @default(uuid())
  code      String           @unique
  type      LedgerAccountType
  name      String
  assetType AssetType?
  createdAt DateTime         @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]

  @@map("ledger_accounts")
}

model JournalEntry {
  id            String           @id @default(uuid())
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  description   String?
  status        JournalEntryStatus @default(POSTED)
  reversalOf    String?          @map("reversal_of")
  createdAt     DateTime         @default(now()) @map("created_at")

  ledgerEntries LedgerEntry[]
  reversal      JournalEntry?    @relation("JournalReversal", fields: [reversalOf], references: [id])
  reversedBy    JournalEntry[]   @relation("JournalReversal")
  orders        Order[]
  transactions  Transaction[]
  withdrawals   WithdrawalRequest[]
  internalTransfers InternalTransfer[]
  deliveryRequests GoldDeliveryRequest[]

  @@index([referenceType, referenceId])
  @@index([status])
  @@index([reversalOf])
  @@map("journal_entries")
}

model LedgerEntry {
  id              String         @id @default(uuid())
  journalEntryId  String         @map("journal_entry_id")
  ledgerAccountId String         @map("ledger_account_id")
  entryType       LedgerEntryType @map("entry_type")
  amountGold      Decimal?       @db.Decimal(18, 8) @map("amount_gold")
  amountToman     BigInt?        @map("amount_toman")
  balanceAfter    Decimal?       @db.Decimal(18, 8) @map("balance_after")
  assetAccountId  String?        @map("asset_account_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  journalEntry  JournalEntry   @relation(fields: [journalEntryId], references: [id])
  ledgerAccount LedgerAccount  @relation(fields: [ledgerAccountId], references: [id])
  assetAccount  AssetAccount?  @relation(fields: [assetAccountId], references: [id])

  @@index([journalEntryId])
  @@index([ledgerAccountId, createdAt])
  @@index([assetAccountId, createdAt])
  @@map("ledger_entries")
}

// ============================================
// Orders & Transactions
// ============================================

model Order {
  id                 String      @id @default(uuid())
  userId             String      @map("user_id")
  type               OrderType
  goldAmount         Decimal     @db.Decimal(18, 8) @map("gold_amount")
  tomanAmount        BigInt      @map("toman_amount")
  unitPrice          BigInt      @map("unit_price")
  spread             Decimal     @db.Decimal(8, 4)
  fee                BigInt
  total              BigInt
  status             OrderStatus @default(PENDING)
  priceLockExpiresAt DateTime?   @map("price_lock_expires_at")
  otpConfirmed       Boolean     @default(false) @map("otp_confirmed")
  journalEntryId     String?     @map("journal_entry_id")
  createdAt          DateTime    @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model Transaction {
  id              String            @id @default(uuid())
  walletId        String            @map("wallet_id")
  userId          String            @map("user_id")
  type            TransactionType
  amount          BigInt
  status          TransactionStatus @default(PENDING)
  gatewayRef      String?           @map("gateway_ref")
  bankRef         String?           @map("bank_ref")
  journalEntryId  String?           @map("journal_entry_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  payment      Payment?

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([status])
  @@map("transactions")
}

// ============================================
// Payments (Gateway)
// ============================================
// رکورد پرداخت درگاه — هر Payment به یک Transaction(DEPOSIT) وصل است.
// Financial Core فقط تومان می شناسد؛ تبدیل واحد خارجی فقط در adapter درگاه.
model Payment {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  transactionId String?       @unique @map("transaction_id")
  gateway       String
  amount        BigInt // تومان
  status        PaymentStatus @default(PENDING)
  authority     String?       @unique // شناسه تراکنش درگاه (ZarinPal Authority)
  refId         String?       @map("ref_id") // مرجع پرداخت پس از verify
  cardPan       String?       @map("card_pan") // masked
  description   String?
  failureReason String?       @map("failure_reason")
  verifiedAt    DateTime?     @map("verified_at")
  expiresAt     DateTime      @map("expires_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

enum WithdrawalSpeed {
  NORMAL
  FAST
}

model WithdrawalRequest {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  amount      BigInt
  iban        String
  status      WithdrawalStatus @default(PENDING)
  speed       WithdrawalSpeed  @default(NORMAL)
  processedBy String?          @map("processed_by")
  processedAt DateTime?        @map("processed_at")
  reviewNote  String?          @map("review_note")
  journalEntryId String?       @map("journal_entry_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  user     User       @relation(fields: [userId], references: [id])
  processor AdminUser? @relation(fields: [processedBy], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("withdrawal_requests")
}

// ============================================
// Bank Accounts (Assets v2)
// ============================================
// کارت‌های بانکی کاربر — شبا با checksum واقعی اعتبارسنجی می‌شود
// نام بانک از کد ۳ رقمی شبا سمت سرور تشخیص داده می‌شود

model BankAccount {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bankCode  String   @map("bank_code")
  bankName  String   @map("bank_name")
  iban      String
  cardPan   String?  @map("card_pan")
  alias     String?
  isDefault Boolean  @default(false) @map("is_default")
  blockedAt DateTime? @map("blocked_at")
  blockNote String?   @map("block_note")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, iban])
  @@index([userId])
  @@map("bank_accounts")
}

// ============================================
// Addresses (دفترچه آدرس — برای تحویل فیزیکی)
// ============================================

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String?
  recipientName String   @map("recipient_name")
  mobile        String
  province      String?
  city          String?
  address       String
  postalCode    String   @map("postal_code")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryRequests GoldDeliveryRequest[]

  @@index([userId])
  @@map("addresses")
}

// ============================================
// Physical Gold Delivery
// ============================================
// درخواست تحویل فیزیکی — طلا قفل نمی‌شود (فاز مینیمال)؛
// فقط در زمان ثبت موجودی آزاد چک می‌شود

enum DeliveryMethod {
  POST
  PICKUP
}

enum DeliveryStatus {
  PENDING
  APPROVED
  PREPARING
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

model GoldDeliveryRequest {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  grams        Decimal         @db.Decimal(18, 6)
  method       DeliveryMethod  @default(POST)
  addressId    String?         @map("address_id")
  status       DeliveryStatus  @default(PENDING)
  reviewNote   String?         @map("review_note")
  trackingCode String?         @map("tracking_code")
  pickupBranch String?         @map("pickup_branch")
  pickupAt     DateTime?       @map("pickup_at")
  feeToman     BigInt?         @map("fee_toman")
  journalEntryId String?       @map("journal_entry_id")
  processedBy  String?         @map("processed_by")
  processedAt  DateTime?       @map("processed_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id])
  address   Address?        @relation(fields: [addressId], references: [id])
  processor AdminUser?      @relation(fields: [processedBy], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("gold_delivery_requests")
}

// ============================================
// Internal Transfers (انتقال طلا/تومان + هدیه)
// ============================================
// جابه‌جایی داخل پلتفرم بین دو کاربر — journal متقارن در ledger

enum TransferKind {
  TRANSFER
  GIFT
}

model InternalTransfer {
  id            String        @id @default(uuid())
  senderId      String        @map("sender_id")
  recipientId   String        @map("recipient_id")
  assetType     AssetType     @map("asset_type")
  tomanAmount   BigInt?       @map("toman_amount")
  goldAmount    Decimal?      @db.Decimal(18, 6) @map("gold_amount")
  kind          TransferKind  @default(TRANSFER)
  giftMessage   String?       @map("gift_message")
  journalEntryId String?      @map("journal_entry_id")
  status        String        @default("COMPLETED")
  flaggedAt     DateTime?     @map("flagged_at")
  flagReason    String?       @map("flag_reason")
  flaggedBy     String?       @map("flagged_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  sender    User          @relation("TransferSender", fields: [senderId], references: [id])
  recipient User          @relation("TransferRecipient", fields: [recipientId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("internal_transfers")
}

// ============================================
// Price Alerts (هشدار قیمت طلا)
// ============================================

enum AlertDirection {
  ABOVE
  BELOW
}

model PriceAlert {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  targetPrice BigInt         @map("target_price")
  direction   AlertDirection
  active      Boolean        @default(true)
  triggeredAt DateTime?      @map("triggered_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@map("price_alerts")
}

// ============================================
// Recurring Buy Plans (پس‌انداز خودکار SIP)
// ============================================

enum SipFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model RecurringBuyPlan {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  tomanAmount BigInt        @map("toman_amount")
  frequency   SipFrequency
  nextRunAt   DateTime      @map("next_run_at")
  active      Boolean       @default(true)
  lastRunAt   DateTime?     @map("last_run_at")
  lastOrderId String?       @map("last_order_id")
  lastError   String?       @map("last_error")
  consecutiveFailures Int   @default(0) @map("consecutive_failures")
  createdAt   DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active, nextRunAt])
  @@map("recurring_buy_plans")
}

// ============================================
// Coins & Bars (سکه و شمش)
// ============================================
// تبدیل طلای آب‌شده به سکه/شمش — کاربر به اندازه وزن محصول طلا
// و به اندازه اجرت تومان می‌پردازد؛ دارایی در CoinHolding ثبت می‌شود

model CoinProduct {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  kind         String   // COIN | BAR
  weightGrams  Decimal  @db.Decimal(18, 8) @map("weight_grams")
  premiumToman BigInt   @map("premium_toman") // اجرت ساخت/ضرب به ازای هر واحد
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  holdings CoinHolding[]

  @@map("coin_products")
}

model CoinHolding {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  productId     String   @map("product_id")
  quantity      Int      @default(0)
  journalEntryId String? @map("journal_entry_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product CoinProduct  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@map("coin_holdings")
}

// ============================================
// Gold Price
// ============================================

model GoldPrice {
  id         String   @id @default(uuid())
  buyPrice   BigInt   @map("buy_price")
  sellPrice  BigInt   @map("sell_price")
  source     String
  rawPrice   BigInt   @map("raw_price")
  spread     Decimal  @db.Decimal(8, 4)
  recordedAt DateTime @map("recorded_at")

  @@index([recordedAt(sort: Desc)])
  @@map("gold_prices")
}

// ============================================
// Idempotency (Durable)
// ============================================

model IdempotencyRecord {
  id           String           @id @default(uuid())
  key          String           @unique
  userId       String?          @map("user_id")
  endpoint     String
  requestHash  String           @map("request_hash")
  responseHash String?          @map("response_hash")
  responseBody Json?            @map("response_body")
  status       IdempotencyStatus @default(PROCESSING)
  createdAt    DateTime         @default(now()) @map("created_at")
  expiresAt    DateTime          @map("expires_at")

  @@index([userId, endpoint])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ============================================
// Rate Limit Config (Configurable)
// ============================================

model RateLimitConfig {
  id            String         @id @default(uuid())
  key           String         @unique
  limit         Int
  windowSeconds Int            @map("window_seconds")
  scope         RateLimitScope
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("rate_limit_configs")
}

// ============================================
// Notifications
// ============================================

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id            String   @id @default(uuid())
  key            String  @unique
  channels       String[]
  titleTemplate  String  @map("title_template")
  bodyTemplate   String  @map("body_template")
  variables      Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

// ============================================
// Tickets
// ============================================

model Ticket {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  subject     String
  category    String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?        @map("assigned_to")
  department  String?
  slaDeadline DateTime?      @map("sla_deadline")
  closedAt    DateTime?      @map("closed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id])
  assignee AdminUser?   @relation(fields: [assignedTo], references: [id])
  messages TicketMessage[]

  @@index([userId, status])
  @@index([assignedTo, status])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  senderType  String   @map("sender_type")
  senderId    String   @map("sender_id")
  body        String
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [senderId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ============================================
// Referrals
// ============================================

model Referral {
  id            String         @id @default(uuid())
  referrerId    String         @map("referrer_id")
  referredId    String         @unique @map("referred_id")
  status        ReferralStatus @default(PENDING)
  qualifiedAt   DateTime?      @map("qualified_at")
  rewardAmount  Decimal?       @db.Decimal(18, 8) @map("reward_amount")
  rewardType    String?        @map("reward_type")
  createdAt     DateTime       @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referred User @relation("Referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

// ============================================
// Installments
// ============================================

model InstallmentPlan {
  id                 String  @id @default(uuid())
  name               String
  months             Int
  downPaymentPercent Decimal @db.Decimal(5, 2) @map("down_payment_percent")
  interestRate       Decimal @db.Decimal(5, 2) @map("interest_rate")
  fee                Decimal @db.Decimal(5, 2)
  minAmount          BigInt  @map("min_amount")
  maxAmount          BigInt  @map("max_amount")
  active             Boolean @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  contracts InstallmentContract[]

  @@map("installment_plans")
}

model InstallmentContract {
  id                   String                   @id @default(uuid())
  userId               String                   @map("user_id")
  planId               String                   @map("plan_id")
  principal            BigInt
  downPayment          BigInt                   @map("down_payment")
  totalPayable         BigInt                   @map("total_payable")
  method               InstallmentMethod
  status               InstallmentContractStatus @default(PENDING)
  chequeNumber         String?                  @map("cheque_number")
  chequeImage          String?                  @map("cheque_image")
  guarantorId          String?                  @map("guarantor_id")
  guarantorApprovedAt  DateTime?                @map("guarantor_approved_at")
  approvedBy           String?                  @map("approved_by")
  approvedAt           DateTime?                @map("approved_at")
  createdAt            DateTime                 @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id])
  plan     InstallmentPlan @relation(fields: [planId], references: [id])
  approver AdminUser?      @relation(fields: [approvedBy], references: [id])
  payments InstallmentPayment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("installment_contracts")
}

model InstallmentPayment {
  id               String                   @id @default(uuid())
  contractId       String                   @map("contract_id")
  installmentNumber Int                     @map("installment_number")
  dueDate          DateTime                 @map("due_date")
  amount           BigInt
  status           InstallmentPaymentStatus @default(PENDING)
  paidAt           DateTime?                @map("paid_at")
  lateFee          BigInt                   @default(0) @map("late_fee")

  contract InstallmentContract @relation(fields: [contractId], references: [id])

  @@index([contractId, installmentNumber])
  @@index([status])
  @@map("installment_payments")
}

// ============================================
// Investments
// ============================================

model InvestmentPlan {
  id              String            @id @default(uuid())
  name            String
  durationDays    Int               @map("duration_days")
  minGoldGram     Decimal           @db.Decimal(18, 8) @map("min_gold_gram")
  interestRateType InterestRateType @map("interest_rate_type")
  rate            Decimal           @db.Decimal(5, 2)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  positions InvestmentPosition[]

  @@map("investment_plans")
}

model InvestmentPosition {
  id         String                   @id @default(uuid())
  userId     String                   @map("user_id")
  planId     String                   @map("plan_id")
  goldAmount Decimal                 @db.Decimal(18, 8) @map("gold_amount")
  startDate  DateTime                 @map("start_date")
  endDate    DateTime                 @map("end_date")
  status     InvestmentPositionStatus @default(ACTIVE)
  closedAt   DateTime?                @map("closed_at")
  createdAt  DateTime                 @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id])
  plan    InvestmentPlan  @relation(fields: [planId], references: [id])
  payouts InterestPayout[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("investment_positions")
}

model InterestPayout {
  id          String   @id @default(uuid())
  positionId  String   @map("position_id")
  amountGold  Decimal  @db.Decimal(18, 8) @map("amount_gold")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  paidAt      DateTime @default(now()) @map("paid_at")

  position InvestmentPosition @relation(fields: [positionId], references: [id])

  @@index([positionId, periodStart])
  @@map("interest_payouts")
}

// ============================================
// Audit Log (Immutable)
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip           String?
  userAgent    String?  @map("user_agent")
  actorRole    String?  @map("actor_role")
  targetUserId String?  @map("target_user_id")
  requestId    String?  @map("request_id")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ============================================
// CMS & Feature Flags
// ============================================

model CmsContent {
  id          String    @id @default(uuid())
  key         String    @unique
  type        String
  title       String?
  body        String?
  slug        String?   @unique
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("cms_contents")
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String   @unique
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0) @map("rollout_percent")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ============================================
// Platform Settings (پیکربندی‌های قابل‌ویرایش ادمین)
// ============================================
// key/value ساده برای تنظیمات عملیاتی — هزینه تحویل، حداقل‌ها و…
// هر تغییر با actor و زمان به‌روزرسانی همراه است؛ audit در سرویس ثبت می‌شود

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ============================================
// Commerce (فروشگاه طلا — Admin Phase 2)
// ============================================
// کاتالوگ محصولات فروشگاهی — مجزا از CoinProduct (تبدیل طلای آب‌شده به سکه)
// Product = محصول قابل‌فروش فروشگاه با موجودی و دسته‌بندی

enum ProductKind {
  COIN
  BAR
  JEWELRY
}

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  categoryId   String?  @map("category_id")
  kind         ProductKind
  weightGrams  Decimal  @db.Decimal(18, 6) @map("weight_grams")
  premiumToman BigInt   @map("premium_toman") // اجرت/حاشیه فروش به تومان
  stock        Int      @default(0)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

// ============================================
// Discount Codes (کدهای تخفیف)
// ============================================
// درصدی یا مبلغی — با سقف استفاده، حداقل خرید و انقضا

enum DiscountType {
  PERCENT
  FIXED
}

enum DiscountAppliesTo {
  TRADE_FEE
  COIN_PREMIUM
  SHOP
}

model DiscountCode {
  id          String            @id @default(uuid())
  code        String            @unique
  type        DiscountType
  value       BigInt // PERCENT → ۱ تا ۱۰۰ | FIXED → تومان
  maxUses     Int?              @map("max_uses")
  usedCount   Int               @default(0) @map("used_count")
  minPurchase BigInt?           @map("min_purchase") // حداقل مبلغ خرید به تومان
  expiresAt   DateTime?         @map("expires_at")
  appliesTo   DiscountAppliesTo @map("applies_to")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([active])
  @@map("discount_codes")
}

// ============================================
// Fee Rules & User Fee Overrides (کارمزدها)
// ============================================
// FeeRule گروهی (سطح KYC یا حجم معامله) — UserFeeOverride فردی
// اولویت محاسبه: override فردی → قانون گروهی → پیش‌فرض env

enum FeeRuleKind {
  KYC_LEVEL
  VOLUME
}

model FeeRule {
  id             String      @id @default(uuid())
  name           String
  kind           FeeRuleKind
  kycLevel       KycLevel?   @map("kyc_level") // برای KYC_LEVEL
  minVolumeToman BigInt?     @map("min_volume_toman") // برای VOLUME — حداقل حجم ۳۰ روز اخیر
  buyFeeBps      Int         @map("buy_fee_bps")
  sellFeeBps     Int         @map("sell_fee_bps")
  priority       Int         @default(0) // بیشتر = اولویت بالاتر
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([kind, active])
  @@map("fee_rules")
}

model UserFeeOverride {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  buyFeeBps  Int?     @map("buy_fee_bps")
  sellFeeBps Int?     @map("sell_fee_bps")
  note       String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_fee_overrides")
}

// ============================================
// Limit Rules (محدودیت‌های مالی)
// ============================================
// سقف سراسری یا به ازای سطح KYC — بازه لغزان DAILY/MONTHLY
// null یعنی بدون سقف برای آن واحد

enum LimitScope {
  WITHDRAW
  TRADE
  TRANSFER
}

enum LimitPeriod {
  DAILY
  MONTHLY
}

model LimitRule {
  id          String      @id @default(uuid())
  scope       LimitScope
  kycLevel    KycLevel?   @map("kyc_level") // null = همه سطوح
  period      LimitPeriod
  amountToman BigInt?     @map("amount_toman") // سقف به تومان (WITHDRAW/TRADE)
  amountGold  Decimal?    @db.Decimal(18, 6) @map("amount_gold") // سقف به گرم (TRANSFER)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([scope, active])
  @@map("limit_rules")
}

// ============================================
// KYC Level Config (سطوح کاربران)
// ============================================
// نام و توضیح هر سطح احراز هویت + امتیاز — توزیع کاربران در گزارش

model KycLevelConfig {
  id          String   @id @default(uuid())
  level       KycLevel @unique
  name        String
  rank        Int      @default(0)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("kyc_level_configs")
}

// ============================================
// Risk Engine (امتیاز ریسک — فاز ۴)
// ============================================
// قوانین پویا: هر قانون روی یک متریک کاربر در بازه زمانی ارزیابی می‌شود
// و در صورت عبور از آستانه، RiskEvent با امتیاز ثبت می‌شود

enum RiskMetric {
  WITHDRAW_SUM        // مجموع برداشت‌های تومانی
  TRADE_SUM           // مجموع معاملات تومانی
  TRANSFER_COUNT      // تعداد انتقال‌های خروجی
  TRANSFER_GOLD       // مجموع گرم انتقال خروجی
  FAILED_PAYMENTS     // تعداد پرداخت‌های ناموفق
  FLAGGED_TRANSFERS   // انتقال‌های پرچم‌دار
  BLOCKED_CARDS       // کارت‌های بانکی مسدود
  LOGIN_IP_CHANGES    // تعداد IPهای متمایز ورود
}

model RiskRule {
  id          String     @id @default(uuid())
  name        String
  metric      RiskMetric
  threshold   Decimal    @db.Decimal(20, 4) // آستانه — واحد به نوع متریک بستگی دارد
  windowHours Int        @default(24) @map("window_hours")
  scoreWeight Int        @default(10) @map("score_weight") // امتیازی که به ریسک کاربر اضافه می‌شود
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  events RiskEvent[]

  @@index([active])
  @@map("risk_rules")
}

model RiskEvent {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  ruleId     String?    @map("rule_id")
  metric     String     // متریک/نوع سیگنال — برای رویدادهای دستی هم کار می‌کند
  score      Int        @default(0)
  detail     Json?
  reviewedAt DateTime?  @map("reviewed_at")
  reviewedBy String?    @map("reviewed_by")
  reviewNote String?    @map("review_note")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule RiskRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reviewedAt])
  @@map("risk_events")
}

// ============================================
// Export History (تاریخچه خروجی‌ها)
// ============================================

model ExportRecord {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  kind      String   // orders | transactions | withdrawals | users | ...
  params    Json?
  rowCount  Int      @default(0) @map("row_count")
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@map("export_records")
}
