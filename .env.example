# ============================================
# Zar30 - Environment Variables
# ============================================
# این فایل را به .env کپی کنید و مقادیر واقعی را پر کنید
# NEVER commit .env to git — فقط .env.example در repo می‌ماند
#
# Production target: https://zar30.com روی VPS + aaPanel
# (Node 24 + pnpm + PM2 + PostgreSQL + Redis + Nginx — بدون Docker)
# ============================================

# ---- Application ----
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://zar30.com
NEXT_PUBLIC_APP_NAME=زرسی

# ---- Mobile (APK) ----
# آدرس کامل سرور API که APK به آن وصل می‌شود — فقط در build:mobile استفاده می‌شود
# Production: https://zar30.com — تست محلی: http://192.168.x.x:3000
NEXT_PUBLIC_API_URL=https://zar30.com

# ---- Database (PostgreSQL native روی همان VPS) ----
# host باید 127.0.0.1 بماند — دیتابیس هرگز public نباشد
DATABASE_URL=postgresql://zar30:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/zar30?schema=public

# ---- Redis native روی همان VPS ----
# host باید 127.0.0.1 بماند — Redis هرگز public نباشد
REDIS_URL=redis://127.0.0.1:6379

# ---- Object Storage (S3-compatible) ----
# مدارک KYC (رمزنگاری‌شده) در bucket خصوصی — هر سرویس S3-compatible
# گزینه‌ها: MinIO نصب‌شده روی همان VPS، یا S3 خارجی (Liara/ArvanCloud/AWS)
# MinIO محلی: S3_ENDPOINT=http://127.0.0.1:9000 + S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=zar30
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true

# ---- KYC Encryption (AES-256-GCM) ----
# کلید رمزنگاری مدارک و داده‌های بانکی KYC — 64 کاراکتر hex (۳۲ بایت)
# تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ---- Auth (JWT) ----
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_DIFFERENT_FROM_ACCESS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=zar30
JWT_AUDIENCE=zar30-users

# ---- OTP ----
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=CHANGE_ME_random_pepper

# ---- Password ----
BCRYPT_COST=12
PASSWORD_PEPPER=CHANGE_ME_random_pepper

# ---- SMS Provider (Kavenegar) ----
# در production حتماً kavenegar — mock فقط development/test
SMS_PROVIDER=kavenegar
SMS_API_KEY=CHANGE_ME_kavenegar_api_key
SMS_SENDER=1000596446

# ---- Dev Tools (فقط development/test — در production هرگز true نکنید) ----
DEV_OTP_ENDPOINT=false

# ---- Payment Gateway (Zarinpal) ----
# sandbox = درگاه شبیه‌سازی dev | zarinpal-sandbox = تست زرین‌پال | zarinpal = واقعی
PAYMENT_PROVIDER=zarinpal
PAYMENT_MERCHANT_ID=CHANGE_ME_zarinpal_merchant_id
PAYMENT_CALLBACK_URL=https://zar30.com/api/v1/payments/callback

# ---- Card → IBAN Resolution ----
# sandbox = dev MOCK | external = سرویس واقعی (مثل Finnotech) | off = غیرفعال
CARD_TO_IBAN_PROVIDER=off
CARD_TO_IBAN_URL=

# ---- Gold Price API ----
# auto = زنجیره fallback: میلی → tgju | mili | tgju | tolochart | manual
PRICE_API_PROVIDER=auto
PRICE_SELL_DISCOUNT_TOMAN=250000
REFERRAL_MIN_BUY_TOMAN=1000000
REFERRAL_REWARD_TOMAN=50000
INSTALLMENT_LATE_FEE_DAILY_PERCENT=0.5
MILI_API_URL=https://milli.gold/api/v1/public/milli-price/external
TGJU_API_URL=https://call.tgju.org/ajax.json
# adapter قدیمی خارجی — فقط اگر PRICE_API_PROVIDER=tolochart
PRICE_API_KEY=
PRICE_API_URL=https://api.tolochart.com/v1
PRICE_FETCH_INTERVAL_SECONDS=60

# ---- Push Notifications ----
# تولید VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
VAPID_SUBJECT=mailto:admin@zar30.com
FCM_SERVER_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=

# ---- Rate Limits (defaults - configurable via DB RateLimitConfig) ----
RATE_LIMIT_GENERAL=100
RATE_LIMIT_GENERAL_WINDOW=60
RATE_LIMIT_OTP=5
RATE_LIMIT_OTP_WINDOW=3600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=3600

# ---- Logging ----
LOG_LEVEL=info
LOG_PRETTY=false

# ---- Business Config (PENDING BUSINESS DECISION - defaults) ----
BUSINESS_SPREAD_PERCENT=0.5
BUSINESS_TRADING_FEE_PERCENT=0.5
BUSINESS_WITHDRAWAL_DAILY_LIMIT=5000000
BUSINESS_INVESTMENT_ANNUAL_RATE=15
BUSINESS_INSTALLMENT_ANNUAL_RATE=10
BUSINESS_REFERRAL_COMMISSION_PERCENT=5
BUSINESS_PHYSICAL_DELIVERY_MIN_GRAMS=100

# ---- Financial Core (Toman-native) ----
# تمام مبالغ سیستم به تومان است
PRICE_MAX_AGE_MINUTES=15
PRICE_MAX_DEVIATION_PERCENT=15
TRADE_FEE_BPS=50
MIN_ORDER_TOMAN=10000
MIN_WITHDRAWAL_TOMAN=50000
MIN_DEPOSIT_TOMAN=5000
MAX_DEPOSIT_TOMAN=500000000
