# ============================================
# Zar30 - Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# ---- Application ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=زرسی

# ---- Database (PostgreSQL 18) ----
DATABASE_URL=postgresql://zar30:zar30_dev_password@localhost:5432/zar30_dev?schema=public

# ---- Redis 7 ----
REDIS_URL=redis://localhost:6379

# ---- Object Storage (MinIO / S3) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zar30
S3_ACCESS_KEY=zar30
S3_SECRET_KEY=zar30_dev_password
S3_FORCE_PATH_STYLE=true

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change_me_in_production_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=zar30
JWT_AUDIENCE=zar30-users

# ---- OTP ----
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=change_me_in_production_otp_pepper

# ---- Password ----
BCRYPT_COST=12
PASSWORD_PEPPER=change_me_in_production_password_pepper

# ---- SMS Provider (Kavenegar) ----
# PENDING BUSINESS DECISION - provider selection
# در development/test می‌توان mock گذاشت — در production حتماً kavenegar
SMS_PROVIDER=kavenegar
SMS_API_KEY=your_kavenegar_api_key
SMS_SENDER=1000596446

# ---- Dev Tools (فقط development/test — در production هرگز true نکنید) ----
# فعال‌سازی GET /api/v1/dev/otp/[mobile] برای خواندن OTP از Redis در تست E2E
# فقط وقتی کار می‌کند که SMS_PROVIDER=mock هم باشد
DEV_OTP_ENDPOINT=false

# ---- Payment Gateway (Zarinpal) ----
# PENDING BUSINESS DECISION - provider selection
PAYMENT_PROVIDER=zarinpal
PAYMENT_MERCHANT_ID=your_zarinpal_merchant_id
PAYMENT_CALLBACK_URL=http://localhost:3000/api/v1/wallet/deposit/verify

# ---- Gold Price API ----
# PENDING BUSINESS DECISION - provider selection
PRICE_API_PROVIDER=tolochart
PRICE_API_KEY=your_price_api_key
PRICE_API_URL=https://api.tolochart.com/v1
PRICE_FETCH_INTERVAL_SECONDS=60

# ---- Push Notifications ----
# PENDING BUSINESS DECISION - VAPID keys generation
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@zar30.com
FCM_SERVER_KEY=your_fcm_server_key
APNS_TEAM_ID=your_apns_team_id
APNS_KEY_ID=your_apns_key_id
APNS_PRIVATE_KEY=your_apns_private_key_p8

# ---- Rate Limits (defaults - configurable via DB RateLimitConfig) ----
RATE_LIMIT_GENERAL=100
RATE_LIMIT_GENERAL_WINDOW=60
RATE_LIMIT_OTP=5
RATE_LIMIT_OTP_WINDOW=3600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=3600

# ---- Logging ----
LOG_LEVEL=debug
LOG_PRETTY=true

# ---- Business Config (PENDING BUSINESS DECISION - defaults for dev only) ----
BUSINESS_SPREAD_PERCENT=0.5
BUSINESS_TRADING_FEE_PERCENT=0.5
BUSINESS_WITHDRAWAL_DAILY_LIMIT=50000000
BUSINESS_INVESTMENT_ANNUAL_RATE=15
BUSINESS_INSTALLMENT_ANNUAL_RATE=10
BUSINESS_REFERRAL_COMMISSION_PERCENT=5
BUSINESS_PHYSICAL_DELIVERY_MIN_GRAMS=100
